# Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Tinkoff / T-Bank Invest API
#
# Three credential pairs, three strictly separated purposes. A token from one
# pair is never used as a fallback for another (Issue #178):
#
#   TINVEST_TOKEN / TINVEST_ACC           market data only (candles, orderbook)
#   TINVEST_SANDBOX / TINVEST_SANDBOX_ACC sandbox order execution
#   TINVEST_LIVE_TOKEN / TINVEST_LIVE_ACC REAL account order execution
#
# Each pair also falls back to the `api` section of backend/config/settings.yaml,
# which is gitignored. Environment variables win.
TINVEST_TOKEN=
TINVEST_ACC=

# Sandbox execution contour (LiveExecutor by default).
# TINVEST_SANDBOX_ACC may stay empty: the client discovers the first open
# sandbox account (SANDBOX_TRADING.discover_account_when_missing).
TINVEST_SANDBOX=
TINVEST_SANDBOX_ACC=

# REAL T-Bank contour (Issue #178, Epic #172 block F).
#
# ALLOW_REAL_TRADING is the master gate and the ONLY way real money can be
# traded. It is false in code and false here:
#
#   false / unset -> LiveExecutor uses TinkoffSandboxClient (sandbox)
#   true          -> LiveExecutor uses TinkoffLiveClient against the REAL account
#
# Accepted words: 1/true/yes/on and 0/false/no/off. Anything else (a typo like
# "ture") fails fast with ValueError at startup instead of silently choosing a
# contour. With ALLOW_REAL_TRADING=true the sandbox client refuses to start, so
# the two contours can never be mixed in one process.
#
# TINVEST_LIVE_ACC may stay empty (the first open real account is discovered),
# but pinning it explicitly is strongly recommended: a real account list can
# contain both a brokerage and an IIS account.
ALLOW_REAL_TRADING=false
TINVEST_LIVE_TOKEN=
TINVEST_LIVE_ACC=

# One physical token for both contours (Issue #192, PO decision of 2026-09-30).
#
# By default TinkoffLiveClient REFUSES to start when TINVEST_LIVE_TOKEN holds the
# same secret as the market-data TINVEST_TOKEN: identical values usually mean the
# operator filled the wrong variable.
#
#   false / unset -> identical values are refused (LiveConfigurationError)
#   true          -> identical values are accepted, with a WARNING in the log
#
# This never introduces a fallback between contours: the real client still reads
# TINVEST_LIVE_TOKEN only and the sandbox client still reads TINVEST_SANDBOX only.
# Parsed strictly like ALLOW_REAL_TRADING - a typo fails fast at startup.
ALLOW_LIVE_TOKEN_REUSE=false

# Telegram notifications (Issue #177). Without them every event stays in the log
# and the executor still runs. TGM_CHAT and TGM_CHAT_ID are synonyms; TGM_CHAT
# wins. /api/notifications/status reports what was actually loaded.
TGM_TOKEN=
TGM_CHAT=
TGM_CHAT_ID=
TGM_APP_ID=
TGM_APP_HASH=

# Preflight (backend/app/analytics/live_executor_preflight.py).
# Which contour the preflight run is expected to validate: `sandbox` (default)
# or `real`. A go-live checklist sets `real` so the report is green by intent
# rather than reporting the enabled real contour as a failure.
PREFLIGHT_EXPECT_CONTOUR=

# PostgreSQL password.
# Password must be provided only via environment variables.
#
# PSTGRS_PWD is the historical name used by docker-compose.yml,
# start_processes.sh and app.core.config_manager. POSTGRES_PASSWORD is the
# standard name and, since Issue #178, is honoured by BOTH readers:
# app.core.config.get_app_database_url() (used by alembic/env.py) prefers
# POSTGRES_PASSWORD and falls back to PSTGRS_PWD. Set one of them - if they
# differ, POSTGRES_PASSWORD wins.
PSTGRS_PWD=
POSTGRES_PASSWORD=

# PostgreSQL connection overrides.
# If PostgreSQL runs on your Windows host and backend runs in Docker,
# use host.docker.internal.
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_DB=postgres

# Optional explicit database URL for future async SQLAlchemy usage.
# Example:
# MARKET_DATA_DATABASE_URL=postgresql://postgres:PASSWORD@host.docker.internal:5432/postgres
MARKET_DATA_DATABASE_URL=

# Optional explicit application DSN. When set it wins over every POSTGRES_*
# variable for BOTH the application and `alembic upgrade head`
# (app.core.config.get_app_database_url). Leave empty in the normal deploy.
# APP_DATABASE_URL=postgresql://postgres:PASSWORD@host.docker.internal:5432/postgres
APP_DATABASE_URL=

# --- Schema migrations (Issue #178) -------------------------------------------
# `docker compose up -d --build backend` runs the one-shot `migrate` service
# (`alembic upgrade head`) first and the API waits for it to exit 0. There is no
# auto-migration in application code.
#   docker compose run --rm migrate                          # migrate only
#   docker compose run --rm migrate alembic current          # where am I
#   docker compose run --rm migrate alembic downgrade -1     # documented rollback
# Rolling back 20260928_001 deletes trading.app_settings.live_kill_switch, and a
# missing row is read as ON (fail-safe): entries stay blocked, they are not
# silently re-enabled.

# Existing analytics schema used by your current database.
MARKET_DATA_SCHEMA=trading
TINVEST_SSL_VERIFY=False

# Live equity risk gates (Issue #176, Epic #172 task D).
# All four are optional; unset means the default from
# backend/app/analytics/trading_config.py (LIVE_RISK / LIVE_TRADING).
# An unparsable or out-of-range value fails fast with ValueError at startup
# instead of silently disabling a risk gate.
#
# Max intraday drawdown in percent of the daily peak equity, range (0, 100].
# Reaching it blocks NEW entries (reason `risk_breach`) until the next MSK
# trading day or a manual reset; open positions keep their broker stops.
# Default: 2.0
MAX_DAILY_LOSS_PCT=
#
# Max notional of a single position in RUB, range (0, 1e12].
# Checked as size_lots * lot_size * entry_price before the order is sent
# (reason `position_size_limit`). Default: 100000
MAX_POSITION_SIZE=
#
# Max simultaneously open/pending live positions, integer range [1, 100].
# Default: 5 (LIVE_TRADING.max_open_positions)
MAX_OPEN_POSITIONS=
#
# Write one trading.live_equity row per executor cycle (true/false/1/0/yes/no/on).
# Setting this to false also disables the drawdown gate - the dry-run switch
# for the whole risk contour. Default: true
LIVE_EQUITY_SNAPSHOT=

# Live alerting and monitoring (Issue #177, Epic #172 task E).
# All seven are optional; unset means the default from
# backend/app/analytics/trading_config.py (LIVE_ALERTING).
# An unparsable or out-of-range value fails fast with ValueError at startup
# instead of silently muting an operator alert.
# Credentials are NOT here (decision D4): Telegram uses TGM_TOKEN / TGM_CHAT_ID
# (or the telegram section of backend/config/settings.yaml), the same source
# /api/notifications/status reads. Without them the executor still runs and
# keeps every event in the log.
#
# Master switch for live Telegram alerts (true/false/1/0/yes/no/on).
# false keeps every event in the log only; the metrics snapshot is still
# written. Default: true
LIVE_TELEGRAM_ALERTS=
#
# Seconds between two "the live loop is alive" heartbeat messages, range (1, 86400].
# A value <= 0 disables the Telegram heartbeat. Default: 3600
LIVE_HEARTBEAT_INTERVAL_SECONDS=
#
# Age after which the heartbeat counts as stale for GET /api/live-trading/metrics,
# range (1, 86400]. Keep it above the send interval if the monitor must stay green
# between heartbeats. Default: 300
LIVE_HEARTBEAT_STALE_SECONDS=
#
# Minimum gap between two alerts sharing one dedup key, range (0, 86400].
# Applies to repeating criticals only (equity_snapshot_error, protection_failed,
# invariant_violation, trailing_amend_failed, oco_orphan, oco_orphan_unverified).
# Default: 300
LIVE_ALERT_DEBOUNCE_SECONDS=
#
# Exit slippage worth an alert, in basis points, range (0, 10000]. Default: 50
LIVE_SLIPPAGE_ALERT_BP=
#
# Consecutive loop errors that stop the executor and raise a critical alert,
# integer range [1, 100]. Single source of truth replacing the hardcoded
# MAX_CONSECUTIVE_ERRORS constant (decision D3). Default: 5
LIVE_MAX_CONSECUTIVE_ERRORS=
#
# Minimum period between two scheduled writes of the metrics snapshot into
# trading.app_settings['live_executor_metrics'], range (1, 86400]. A delivered
# heartbeat, a kill-switch transition and graceful shutdown always write
# (decision D5). Default: 300
LIVE_METRICS_FLUSH_SECONDS=
